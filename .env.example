# ── Supabase ──────────────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in the values from your Supabase
# project (Project Settings → API). Until these are set, the app runs on mock
# data so you can develop the UI without a backend.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — never expose to the browser / never prefix with
# NEXT_PUBLIC. Used for form inserts and dashboard reads.
SUPABASE_SERVICE_ROLE_KEY=

# ── Email notifications (optional) ────────────────────────────────────────────
# Resend (https://resend.com). When all three are set, the producer is emailed
# on each new custom request / booking. Leave blank to disable (no-op).
RESEND_API_KEY=
RESEND_FROM=Ibiga Beatz <onboarding@resend.dev>
PRODUCER_NOTIFY_EMAIL=
